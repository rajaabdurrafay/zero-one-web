{
  "name": "zeroone-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "website",
    "admin",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:website": "npm run dev --workspace=website",
    "build:admin": "npm run build --workspace=admin",
    "build:backend": "npm run build --workspace=backend",
    "build:website": "npm run build --workspace=website",
    "start:admin": "npm run start --workspace=admin",
    "start:backend": "npm run start --workspace=backend",
    "start:website": "npm run start --workspace=website",
    "build": "npm run build:backend && npm run build:website && npm run build:admin",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace=backend",
    "audit:production": "node scripts/audit-production.cjs",
    "lint": "npm run lint --workspace=website && npm run lint --workspace=admin",
    "test:frontends": "node scripts/smoke-frontends.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
